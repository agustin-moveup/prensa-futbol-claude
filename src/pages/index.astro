---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PfHero from "@/components/PfHero.astro";
import PfSectionHeading from "@/components/PfSectionHeading.astro";
import PfBookmakerBanner from "@blocks/pf/pf-bookmaker-banner/index";
import { sampleData as bannerData } from "@blocks/pf/pf-bookmaker-banner/sample-data";
import PfMatchTipCard from "@blocks/pf/pf-match-tip-card/index";
import { sampleData as matchTipData } from "@blocks/pf/pf-match-tip-card/sample-data";
import PfCompetitionAccordion from "@blocks/pf/pf-competition-accordion/index";
import { sampleData as accordionData } from "@blocks/pf/pf-competition-accordion/sample-data";
import PfBookmakerList from "@blocks/pf/pf-bookmaker-list/index";
import { sampleData as bookmakerData } from "@blocks/pf/pf-bookmaker-list/sample-data";
import PfTipsterCard from "@blocks/pf/pf-tipster-card/index";
import { sampleData as tipsterData } from "@blocks/pf/pf-tipster-card/sample-data";
import PfLinkGrid from "@blocks/pf/pf-link-grid/index";
import { sampleData as linkGridData } from "@blocks/pf/pf-link-grid/sample-data";
import PfOfferList from "@blocks/pf/pf-offer-list/index";
import { sampleData as offerData } from "@blocks/pf/pf-offer-list/sample-data";
import PfSeoText from "@blocks/pf/pf-seo-text/index";
import { sampleData as seoData } from "@blocks/pf/pf-seo-text/sample-data";
import PfMatchOdds from "@blocks/pf/pf-match-odds/index";
import { sampleData as matchOddsData } from "@blocks/pf/pf-match-odds/sample-data";
import PfPostCard from "@blocks/pf/pf-post-card/index";
import { sampleData as postData } from "@blocks/pf/pf-post-card/sample-data";
import PfEventSpotlight from "@blocks/pf/pf-event-spotlight/index";
import { sampleData as spotlightData } from "@blocks/pf/pf-event-spotlight/sample-data";
import PfNewsletter from "@blocks/pf/pf-newsletter/index";
import { sampleData as newsletterData } from "@blocks/pf/pf-newsletter/sample-data";
import PfContentBlock from "@blocks/pf/pf-content-block/index";
import { sampleData as contentBlockData } from "@blocks/pf/pf-content-block/sample-data";

// Reuse the card variant items in the compact sidebar variant
const sidebarListData = {
  variant: "sidebar" as const,
  items: bookmakerData.card.default.items,
};
---

<BaseLayout>
  <div class="pf-page">

    <PfHero />

    <!-- Banner comercial top -->
    <div class="pf-page__banner">
      <div class="pf-page__container">
        <PfBookmakerBanner {...bannerData.default.default} client:visible />
      </div>
    </div>

    <main class="pf-page__main">
      <div class="pf-page__container">
        <div class="pf-page__layout">

          <!-- ── Main content column ── -->
          <div class="pf-page__content">

            <!-- No te pierdas estos partidos -->
            <section class="pf-section">
              <PfSectionHeading heading="No te pierdas estos partidos" ctaLabel="Ver todos" ctaHref="/pronosticos" />
              <div class="pf-tip-slider">
                <div class="pf-tip-slider__item">
                  <PfMatchTipCard {...matchTipData.default.default} client:visible />
                </div>
                <div class="pf-tip-slider__item">
                  <PfMatchTipCard {...matchTipData.default.libertadores} client:visible />
                </div>
                <div class="pf-tip-slider__item">
                  <PfMatchTipCard {...matchTipData.default.premierLeague} client:visible />
                </div>
                <div class="pf-tip-slider__item">
                  <PfMatchTipCard {...matchTipData.default.mundialClub} client:visible />
                </div>
              </div>
            </section>

            <!-- Partidos por competición -->
            <section class="pf-section">
              <PfSectionHeading heading="Pronósticos por competición" />
              <div class="pf-section__stack">
                <PfCompetitionAccordion {...accordionData.default.default} client:visible />
                <PfCompetitionAccordion {...accordionData.default.closed} client:visible />
              </div>
            </section>

            <!-- Conoce a nuestros expertos -->
            <section class="pf-section">
              <PfSectionHeading heading="Nuestros expertos" />
              <div class="pf-section__grid-2">
                <PfTipsterCard {...tipsterData.default.default} client:visible />
                <PfTipsterCard {...tipsterData.default.alternate} client:visible />
              </div>
            </section>

            <!-- Ofertas destacadas (código: copy / reveal / none) -->
            <section class="pf-section">
              <PfOfferList {...offerData.code.showcase} client:visible />
            </section>

            <!-- Ofertas destacadas (variante: pros / ranking) -->
            <section class="pf-section">
              <PfOfferList {...offerData.pros.default} client:visible />
            </section>

            <!-- Match odds example -->
            <section class="pf-section">
              <PfMatchOdds {...matchOddsData.default.default} client:visible />
            </section>

            <!-- Guías y códigos promocionales -->
            <section class="pf-section">
              <PfLinkGrid {...linkGridData.default.default} client:visible />
            </section>

            <!-- Cobertura especial: Mundial 2026 -->
            <section class="pf-section">
              <PfEventSpotlight {...spotlightData.mundial.spotlight} client:visible />
            </section>


            <!-- Últimas noticias -->
            <section class="pf-section">
              <PfSectionHeading heading="Últimas noticias" ctaLabel="Ver todas" ctaHref="/noticias" />
              <div class="pf-news-slider">
                <div class="pf-news-slider__item">
                  <PfPostCard {...postData.featured.knicks} client:visible />
                </div>
                <div class="pf-news-slider__item">
                  <PfPostCard {...postData.featured.tabilo} client:visible />
                </div>
                <div class="pf-news-slider__item">
                  <PfPostCard {...postData.featured.garin} client:visible />
                </div>
                <div class="pf-news-slider__item">
                  <PfPostCard {...postData.featured.coloColo} client:visible />
                </div>
                <div class="pf-news-slider__item">
                  <PfPostCard {...postData.featured.chileMundial} client:visible />
                </div>
              </div>
            </section>

            <!-- Prensa Fútbol une deporte y apuestas (features) -->
            <section class="pf-section">
              <PfContentBlock {...contentBlockData.features.default} client:visible />
            </section>

            <!-- Cómo elegimos las casas de apuestas (FAQ) -->
            <section class="pf-section">
              <PfContentBlock {...contentBlockData.faq.default} client:visible />
            </section>

            <!-- SEO footer -->
            <section class="pf-section pf-section--last">
              <PfSeoText {...seoData.default.default} client:visible />
            </section>

          </div><!-- /pf-page__content -->

          <!-- ── Right sidebar ── -->
          <aside class="pf-page__sidebar" aria-label="Top casas de apuestas">
            <div class="pf-page__sidebar-inner">
              <PfSectionHeading
                heading="Top casas Chile"
                ctaLabel="Ver todas"
                ctaHref="/casas-de-apuestas"
              />
              <PfBookmakerList {...sidebarListData} title="" client:visible />
            </div>
          </aside>

        </div><!-- /pf-page__layout -->
      </div>
    </main>

    <!-- Newsletter — full-width strip -->
    <PfNewsletter {...newsletterData.default.default} client:visible />

  </div>
</BaseLayout>

<style>
  .pf-page {
    min-height: 100dvh;
  }

  .pf-page__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--gds-space-5);
  }

  /* Banner strip */
  .pf-page__banner {
    padding: var(--gds-space-4) 0;
    border-bottom: 1px solid var(--gds-color-border);
  }

  /* Main content */
  .pf-page__main {
    padding: var(--gds-space-7) 0 var(--gds-space-8);
  }

  /* Two-column layout: main + sidebar */
  .pf-page__layout {
    display: grid;
    grid-template-columns: 1fr 272px;
    align-items: start;
    gap: 0 var(--gds-space-6);
  }

  .pf-page__content {
    min-width: 0;
  }

  /* Sticky sidebar */
  .pf-page__sidebar-inner {
    position: sticky;
    top: var(--gds-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--gds-space-5);
  }

  /* Sections */
  .pf-section {
    display: flex;
    flex-direction: column;
    gap: var(--gds-space-5);
    padding-bottom: var(--gds-space-8);
    border-bottom: 1px solid var(--gds-color-border);
    margin-bottom: var(--gds-space-8);
  }

  .pf-section--last {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Match tip slider */
  .pf-tip-slider {
    display: flex;
    gap: var(--gds-space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--gds-space-5);
    padding-bottom: var(--gds-space-3);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gds-color-surface-elevated) transparent;
  }

  .pf-tip-slider__item {
    flex: 0 0 min(400px, 90vw);
    scroll-snap-align: start;
    min-width: 0;
  }

  .pf-tip-slider__item > * {
    display: block;
    width: 100%;
  }

  /* News slider — featured cards, fixed height */
  .pf-news-slider {
    display: flex;
    gap: var(--gds-space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--gds-space-5);
    padding-bottom: var(--gds-space-3);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gds-color-surface-elevated) transparent;
  }

  .pf-news-slider__item {
    flex: 0 0 min(300px, 85vw);
    scroll-snap-align: start;
    min-width: 0;
    height: 280px;
  }

  .pf-news-slider__item > * {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Section layouts */
  .pf-section__stack {
    display: flex;
    flex-direction: column;
    gap: var(--gds-space-3);
  }

  .pf-section__grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gds-space-5);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .pf-page__layout {
      grid-template-columns: 1fr;
    }

    .pf-page__sidebar-inner {
      position: static;
    }

    /* On mobile the sidebar appears below all main content */
    .pf-page__sidebar {
      padding-top: var(--gds-space-8);
      border-top: 1px solid var(--gds-color-border);
    }
  }

  @media (max-width: 768px) {
    .pf-page__container {
      padding: 0 var(--gds-space-4);
    }

    .pf-section__grid-2 {
      grid-template-columns: 1fr;
    }

    .pf-section {
      padding-bottom: var(--gds-space-6);
      margin-bottom: var(--gds-space-6);
    }
  }
</style>
