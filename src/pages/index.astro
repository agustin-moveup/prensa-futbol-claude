---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PfHero from "@/components/PfHero.astro";
import PfSectionHeading from "@/components/PfSectionHeading.astro";
import PfBookmakerBanner from "@blocks/pf/pf-bookmaker-banner/index";
import { sampleData as bannerData } from "@blocks/pf/pf-bookmaker-banner/sample-data";
import PfMatchTipCard from "@blocks/pf/pf-match-tip-card/index";
import { sampleData as matchTipData } from "@blocks/pf/pf-match-tip-card/sample-data";
import PfCompetitionAccordion from "@blocks/pf/pf-competition-accordion/index";
import { sampleData as accordionData } from "@blocks/pf/pf-competition-accordion/sample-data";
import PfBookmakerList from "@blocks/pf/pf-bookmaker-list/index";
import { sampleData as bookmakerData } from "@blocks/pf/pf-bookmaker-list/sample-data";
import PfTipsterCard from "@blocks/pf/pf-tipster-card/index";
import { sampleData as tipsterData } from "@blocks/pf/pf-tipster-card/sample-data";
import PfLinkGrid from "@blocks/pf/pf-link-grid/index";
import { sampleData as linkGridData } from "@blocks/pf/pf-link-grid/sample-data";
import PfSeoText from "@blocks/pf/pf-seo-text/index";
import { sampleData as seoData } from "@blocks/pf/pf-seo-text/sample-data";
---

<BaseLayout>
  <div class="pf-page">

    <PfHero />

    <!-- Banner comercial top -->
    <div class="pf-page__banner">
      <div class="pf-page__container">
        <PfBookmakerBanner {...bannerData.default.default} client:visible />
      </div>
    </div>

    <main class="pf-page__main">
      <div class="pf-page__container">

        <!-- No te pierdas estos partidos -->
        <section class="pf-section">
          <PfSectionHeading heading="No te pierdas estos partidos" ctaLabel="Ver todos" ctaHref="/pronosticos" />
          <div class="pf-tip-slider">
            <div class="pf-tip-slider__item">
              <PfMatchTipCard {...matchTipData.default.default} client:visible />
            </div>
            <div class="pf-tip-slider__item">
              <PfMatchTipCard {...matchTipData.default.libertadores} client:visible />
            </div>
            <div class="pf-tip-slider__item">
              <PfMatchTipCard {...matchTipData.default.premierLeague} client:visible />
            </div>
            <div class="pf-tip-slider__item">
              <PfMatchTipCard {...matchTipData.default.mundialClub} client:visible />
            </div>
          </div>
        </section>

        <!-- Partidos por competición -->
        <section class="pf-section">
          <PfSectionHeading heading="Pronósticos por competición" />
          <div class="pf-section__stack">
            <PfCompetitionAccordion {...accordionData.default.default} client:visible />
            <PfCompetitionAccordion {...accordionData.default.closed} client:visible />
          </div>
        </section>

        <!-- Conoce a nuestros expertos -->
        <section class="pf-section">
          <PfSectionHeading heading="Nuestros expertos" />
          <div class="pf-section__grid-2">
            <PfTipsterCard {...tipsterData.default.default} client:visible />
            <PfTipsterCard {...tipsterData.default.alternate} client:visible />
          </div>
        </section>

        <!-- Top casas Chile -->
        <section class="pf-section">
          <PfSectionHeading heading="Top casas de apuestas Chile" ctaLabel="Ver todas" ctaHref="/casas-de-apuestas" />
          <PfBookmakerList {...bookmakerData.card.default} title="" client:visible />
        </section>

        <!-- Guías y códigos promocionales -->
        <section class="pf-section">
          <PfLinkGrid {...linkGridData.default.default} client:visible />
        </section>

        <!-- SEO footer -->
        <section class="pf-section pf-section--last">
          <PfSeoText {...seoData.default.default} client:visible />
        </section>

      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .pf-page {
    min-height: 100dvh;
  }

  .pf-page__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--gds-space-5);
  }

  /* Banner strip */
  .pf-page__banner {
    padding: var(--gds-space-4) 0;
    border-bottom: 1px solid var(--gds-color-border);
  }

  /* Main content */
  .pf-page__main {
    padding: var(--gds-space-7) 0 var(--gds-space-8);
  }

  /* Sections */
  .pf-section {
    display: flex;
    flex-direction: column;
    gap: var(--gds-space-5);
    padding-bottom: var(--gds-space-8);
    border-bottom: 1px solid var(--gds-color-border);
    margin-bottom: var(--gds-space-8);
  }

  .pf-section--last {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Match tip slider */
  .pf-tip-slider {
    display: flex;
    gap: var(--gds-space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--gds-space-5);
    padding-bottom: var(--gds-space-3);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--gds-color-surface-elevated) transparent;
  }

  .pf-tip-slider__item {
    flex: 0 0 min(400px, 90vw);
    scroll-snap-align: start;
    min-width: 0;
  }

  /* astro-island wrapper needs to fill the slot */
  .pf-tip-slider__item > * {
    display: block;
    width: 100%;
  }

  /* Section layouts */
  .pf-section__stack {
    display: flex;
    flex-direction: column;
    gap: var(--gds-space-3);
  }

  .pf-section__grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gds-space-5);
  }

  @media (max-width: 768px) {
    .pf-page__container {
      padding: 0 var(--gds-space-4);
    }

    .pf-section__grid-2 {
      grid-template-columns: 1fr;
    }

    .pf-section {
      padding-bottom: var(--gds-space-6);
      margin-bottom: var(--gds-space-6);
    }
  }
</style>
