---
import { generateCssVars } from "@/lib/tokens";
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prensa Futbol — Apuestas, Cuotas y Tips de Fútbol Chile",
  description = "Las mejores cuotas, tips de expertos y guías de casas de apuestas para el fútbol chileno.",
} = Astro.props;

const cssVars = generateCssVars();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />
    <style set:html={`.pf-scope {\n${cssVars}\n}`}></style>
  </head>
  <body>
    <div class="pf-scope">
      <SiteHeader />
      <slot />
    </div>
  </body>
</html>
