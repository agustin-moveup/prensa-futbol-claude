---
import { generateCssVars } from "@/lib/tokens";
import SiteHeader from "@/components/SiteHeader.astro";
import PfFooter from "@/components/PfFooter.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prensa Futbol — Apuestas, Cuotas y Tips de Fútbol Chile",
  description = "Las mejores cuotas, tips de expertos y guías de casas de apuestas para el fútbol chileno.",
} = Astro.props;

const cssVars = generateCssVars();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Roboto:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <style set:html={`.pf-scope {\n${cssVars}\n}`}></style>
  </head>
  <body>
    <div class="pf-scope">
      <div class="pf-brand-glow" aria-hidden="true"></div>
      <SiteHeader />
      <slot />
      <PfFooter />
    </div>
  </body>
</html>

<style>
  .pf-brand-glow {
    position: fixed;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 480px;
    background: radial-gradient(ellipse at 50% 20%, #cc0000 0%, rgba(204,0,0,0.3) 35%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.55;
  }
</style>
