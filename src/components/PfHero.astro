---
// Homepage hero — no heavy images, CSS-only visual layer
---

<section class="pf-hero">
  <div class="pf-hero__inner">
    <div class="pf-hero__content">
      <div class="pf-hero__text">
        <h1 class="pf-hero__title">
          Prensa Fútbol: <em class="pf-hero__title-em">noticias y apuestas</em> en un solo lugar
        </h1>
        <p class="pf-hero__sub">
          Las últimas noticias deportivas, análisis experto y las mejores oportunidades de apuestas, todo en un solo lugar.
        </p>
      </div>
      <div class="pf-hero__links">
        <a href="/casas-de-apuestas" class="pf-hero__link pf-hero__link--primary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8h8M7 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="11" cy="8" r="1.5" fill="currentColor"/>
          </svg>
          Mejores casas de apuestas
        </a>
        <a href="/ofertas" class="pf-hero__link pf-hero__link--secondary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2l1.5 3.5L13 6.5l-2.5 2.5.6 3.5L8 11l-3.1 1.5.6-3.5L3 6.5l3.5-1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          </svg>
          Ofertas deportivas
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pf-hero {
    position: relative;
    padding: var(--pf-space-7) 0;
  }

  .pf-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--pf-space-5);
  }

  /* Two-column: text left, CTAs right */
  .pf-hero__content {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--pf-space-8);
  }

  .pf-hero__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--pf-space-4);
  }

  /* H1 */
  .pf-hero__title {
    font-family: var(--pf-font-body);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.05;
    color: var(--pf-color-text);
    font-style: normal;
    margin: 0;
  }

  .pf-hero__title-em {
    color: var(--pf-color-primary);
    font-style: normal;
  }

  /* Subtitle */
  .pf-hero__sub {
    font-family: var(--pf-font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--pf-color-text-muted);
    margin: 0;
  }

  /* CTA column — fixed width so both buttons are equal */
  .pf-hero__links {
    display: flex;
    flex-direction: column;
    gap: var(--pf-space-3);
    flex-shrink: 0;
    width: 230px;
  }

  .pf-hero__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--pf-space-2);
    width: 100%;
    padding: var(--pf-space-3) var(--pf-space-4);
    border-radius: var(--pf-radius-sm);
    font-family: var(--pf-font-body);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .pf-hero__link--primary {
    background: var(--pf-color-primary-deep);
    color: var(--pf-color-text);
    border: 1px solid transparent;
  }

  .pf-hero__link--primary:hover {
    background: var(--pf-color-primary);
  }

  .pf-hero__link--secondary {
    background: transparent;
    color: var(--pf-color-text);
    border: 1px solid var(--pf-color-border);
  }

  .pf-hero__link--secondary:hover {
    border-color: var(--pf-color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-hero__link {
      transition: none;
    }
  }

  /* Mobile: stack back to column */
  @media (max-width: 640px) {
    .pf-hero {
      padding: var(--pf-space-6) 0;
    }

    .pf-hero__inner {
      padding: 0 var(--pf-space-4);
    }

    .pf-hero__content {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--pf-space-5);
    }

    .pf-hero__links {
      width: 100%;
    }
  }
</style>
